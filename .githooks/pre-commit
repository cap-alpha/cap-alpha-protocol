#!/bin/sh
#
# Pre-commit hook: lint + unit tests via local venv
#
# Runs ruff (format + lint) and pytest. No Docker required.
#
# Bootstrap: make setup

set -e

echo "=== Pre-commit: node_modules symlink guard ==="

# node_modules must never be tracked in git — it's either a real npm-managed
# directory or a worktree-local symlink created by
# scripts/configure_agent_identity.sh, both gitignored. This has recurred
# twice (#588, #1179): a broad `git add -A`/`-f` in an unrelated commit
# re-staged the symlink despite the gitignore rule already covering it.
STAGED_NODE_MODULES=$(git diff --cached --name-only | grep -E '(^|/)node_modules$' || true)
if [ -n "$STAGED_NODE_MODULES" ]; then
    echo ""
    echo "ERROR: refusing to commit a tracked node_modules path:"
    echo "$STAGED_NODE_MODULES"
    echo "node_modules must never be committed to git (see #588, #1179)."
    echo "Run: git restore --staged <path>"
    exit 1
fi

VENV=".venv"

# Resolve the main repo root — works from worktrees too.
MAIN_REPO="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"

# Check for venv: current dir first, then main repo root
if [ -d "$VENV" ]; then
    ACTIVATE="$VENV/bin/activate"
elif [ -d "$MAIN_REPO/$VENV" ]; then
    ACTIVATE="$MAIN_REPO/$VENV/bin/activate"
else
    echo "ERROR: No .venv found. Run 'make setup' from the main repo."
    exit 1
fi

# shellcheck disable=SC1090
. "$ACTIVATE"

echo "=== Pre-commit: Linting ==="

if ! command -v ruff > /dev/null 2>&1; then
    echo "Warning: ruff not found in venv — skipping lint. Run 'make setup' to install."
else
    ruff check pipeline/src/ pipeline/tests/ || {
        echo ""
        echo "Ruff lint failed. Run: ruff check pipeline/src/ pipeline/tests/"
        exit 1
    }
    ruff format --check pipeline/src/ pipeline/tests/ || {
        echo ""
        echo "Ruff format failed. Run: ruff format pipeline/src/ pipeline/tests/"
        exit 1
    }
fi

echo "=== Pre-commit: Tests (Docker) ==="

# Check if the pipeline container is running
if docker compose --env-file docker_env.txt ps --format '{{.Name}}' 2>/dev/null | grep -q pipeline; then
    docker compose --env-file docker_env.txt exec -T pipeline bash -c \
        "cd /app && python -m pytest pipeline/tests/ -x -q --tb=short -m 'not integration' \
        --ignore=pipeline/tests/test_api.py \
        --ignore=pipeline/tests/test_api_vegas.py \
        --ignore=pipeline/tests/test_ledger_bq_integration.py" \
        || { echo "Tests failed! Aborting commit."; exit 1; }
else
    echo "Warning: Docker pipeline container not running — skipping tests. Run 'make up' to enable pre-commit tests."
    echo "Proceeding without tests — CI will catch failures."
fi

echo "=== Pre-commit: TypeScript type check ==="

# Run tsc --noEmit when any web/ file is staged to catch type errors before CI.
STAGED_WEB=$(git diff --cached --name-only | grep "^web/" || true)
if [ -n "$STAGED_WEB" ]; then
    # Resolve web/ directory relative to the main repo root so this works in worktrees.
    WEB_DIR="$MAIN_REPO/web"
    if [ -d "$WEB_DIR/node_modules" ]; then
        echo "web/ files staged — running tsc --noEmit..."
        (cd "$WEB_DIR" && npx --no-install tsc --noEmit) || {
            echo ""
            echo "TypeScript errors found. Fix them before committing."
            echo "Run: cd web && npx tsc --noEmit"
            exit 1
        }
    else
        echo "Warning: web/node_modules not found — skipping tsc. Run: cd web && npm ci"
    fi
fi

echo "=== Pre-commit: CODEBASE.md staleness check ==="

# Warn (don't block) if structural files changed but CODEBASE.md wasn't touched.
STRUCTURAL_PATTERNS="pipeline/src/ pipeline/api/ pipeline/config/ web/app/ dbt/ .githooks/pre-commit Makefile"
CHANGED=$(git diff --cached --name-only)

structural_changed=0
for pattern in $STRUCTURAL_PATTERNS; do
    if echo "$CHANGED" | grep -q "^$pattern"; then
        structural_changed=1
        break
    fi
done

codebase_md_changed=$(echo "$CHANGED" | grep -c "^CODEBASE\.md" || true)

if [ "$structural_changed" -eq 1 ] && [ "$codebase_md_changed" -eq 0 ]; then
    echo ""
    echo "⚠  Structural files changed but CODEBASE.md was not updated."
    echo "   If you added/moved/renamed a module, API route, BQ table, or entry point,"
    echo "   update CODEBASE.md before merging. Skip only if the change is internal."
    echo ""
fi

echo "Pre-commit checks passed."
