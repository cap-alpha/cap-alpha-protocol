#!/usr/bin/env bash
# gh-lars — gh CLI wrapper authenticated as the cap-alpha-workflow-automation GitHub App.
#
# Replaces the previous LARS_TOKEN PAT approach with installation tokens minted
# by scripts/gh-app-token.sh. Tokens last 1 hour and are cached automatically.
#
# Usage: identical to `gh` — just call `gh-lars <gh-args>`
#
# Rate limits: GitHub App installation tokens get 5,000 req/hr per installation,
# vs ~1,000/hr for PATs (and much lower for new accounts). No more abuse flags.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Resolve main repo root — works from both main checkout and worktrees.
# --git-common-dir returns relative path from main checkout, absolute from worktrees.
# Normalise by cd-ing from SCRIPT_DIR so relative paths are anchored correctly.
_GIT_COMMON="$(git -C "$SCRIPT_DIR" rev-parse --git-common-dir 2>/dev/null || true)"
# If absolute (worktree case), use directly; if relative, resolve from SCRIPT_DIR.
case "$_GIT_COMMON" in
    /*) MAIN_REPO="$(cd "$_GIT_COMMON/.." && pwd)" ;;
    *)  MAIN_REPO="$(cd "$SCRIPT_DIR/$_GIT_COMMON/.." && pwd)" ;;
esac
TOKEN_SCRIPT="${SCRIPT_DIR}/gh-app-token.sh"
PERSONAS_FILE="${MAIN_REPO}/.env.personas"

# Source .env.personas to pick up required GitHub App settings (and Slack creds)
# when either GH_APP_ID or GH_INSTALLATION_ID is not already set — lets agents
# call gh-lars without pre-sourcing the file themselves.
if [[ -f "$PERSONAS_FILE" ]] && { [[ -z "${GH_APP_ID:-}" ]] || [[ -z "${GH_INSTALLATION_ID:-}" ]]; }; then
    set -a; source "$PERSONAS_FILE"; set +a
fi

if [[ ! -x "$TOKEN_SCRIPT" ]]; then
    echo "gh-lars: token script not found or not executable: $TOKEN_SCRIPT" >&2
    exit 1
fi

# Mint GitHub App installation token — required, no fallback to user auth.
# All automation must run as the GitHub App, never as a human account.
GH_TOKEN=""
if ! GH_TOKEN="$("$TOKEN_SCRIPT" 2>&1)"; then
    echo "gh-lars: GitHub App token minting failed — cannot proceed." >&2
    echo "  Check GH_APP_ID, GH_INSTALLATION_ID in .env.personas and PEM at ~/.ghconfig/triage-app.pem" >&2
    echo "  Error: $GH_TOKEN" >&2
    exit 1
fi
if [[ -z "$GH_TOKEN" ]]; then
    echo "gh-lars: GitHub App token was empty — aborting." >&2
    exit 1
fi
export GH_TOKEN

# ---------------------------------------------------------------------------
# pr merge preflight gate — runs before every `gh-lars pr merge <N> ...`
#
# Calls scripts/preflight-merge.sh <N> to verify:
#   1. CI checks are registered (non-empty)
#   2. No non-advisory check has conclusion == FAILURE (PENDING/IN_PROGRESS are not failures)
#   3. At least one real CI check (lint|test|preflight|build|extraction) is registered
#      and either passed (SUCCESS) or is still running — merge queue will wait for in-progress checks
#
# Pass --force-merge-bypass-preflight to skip the check with a loud warning.
# ---------------------------------------------------------------------------
_is_pr_merge=false
_bypass_preflight=false
_pr_number=""

if [[ "${1:-}" == "pr" && "${2:-}" == "merge" ]]; then
    _is_pr_merge=true

    # Scan remaining args for --force-merge-bypass-preflight and the PR number.
    # The PR number is the first positional argument after "pr merge" (not a flag).
    _remaining_args=()
    _found_pr_number=false
    for _arg in "${@:3}"; do
        if [[ "$_arg" == "--force-merge-bypass-preflight" ]]; then
            _bypass_preflight=true
        else
            _remaining_args+=("$_arg")
            # Capture the first non-flag arg as the PR number
            if [[ ! "$_arg" == --* ]] && [[ "$_found_pr_number" == "false" ]]; then
                _pr_number="$_arg"
                _found_pr_number=true
            fi
        fi
    done
fi

if [[ "$_is_pr_merge" == "true" ]]; then
    if [[ "$_bypass_preflight" == "true" ]]; then
        echo "" >&2
        echo "⚠️  WARNING: --force-merge-bypass-preflight flag detected." >&2
        echo "   Skipping CI preflight gate for PR #${_pr_number}." >&2
        echo "   Merging with bypassed safety check — proceed with caution." >&2
        echo "" >&2
        exec gh pr merge "${_remaining_args[@]+"${_remaining_args[@]}"}"
    fi

    if [[ -z "$_pr_number" ]]; then
        echo "gh-lars: pr merge: could not determine PR number from arguments — skipping preflight." >&2
        exec gh "$@"
    fi

    PREFLIGHT_SCRIPT="${SCRIPT_DIR}/preflight-merge.sh"
    if [[ ! -x "$PREFLIGHT_SCRIPT" ]]; then
        echo "gh-lars: preflight-merge.sh not found or not executable: $PREFLIGHT_SCRIPT" >&2
        echo "  Skipping preflight gate (script missing)." >&2
        exec gh "$@"
    fi

    if ! "$PREFLIGHT_SCRIPT" "$_pr_number"; then
        echo "" >&2
        echo "gh-lars: pr merge aborted — preflight gate failed for PR #${_pr_number}." >&2
        echo "  Fix the above CI failures before merging." >&2
        echo "  To bypass (not recommended): add --force-merge-bypass-preflight" >&2
        exit 1
    fi

    # Preflight passed — proceed with the actual merge (drop bypass flag, already consumed)
    exec gh pr merge "${_remaining_args[@]+"${_remaining_args[@]}"}"
fi

exec gh "$@"
